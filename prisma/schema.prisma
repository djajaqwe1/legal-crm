generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Тенант: одна юр. практика / покупатель SaaS; изолирует данные CRM и настройки лендинга.
model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients      Client[]
  legalObjects LegalObject[]
  legalCases   LegalCase[]
  contracts    Contract[]
  chatMessages ChatMessage[]
  jarvisSessions JarvisSession[]
  paymentTransactions PaymentTransaction[]
}

model Client {
  id                  String           @id @default(cuid())
  workspaceId         String
  name                String
  manager             String
  /// Физлицо или юрлицо — для структуры папок как на OneDrive
  category            ClientCategory   @default(LEGAL_ENTITY)
  /// Группа: «Физлица», «Юрлица», имя крупного клиента
  folderGroup         String?
  /// Папка клиента в OneDrive / SharePoint
  oneDriveUrl         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  email               String?
  phone               String?
  portalPasswordHash  String?
  contracts           Contract[]
  cases               LegalCase[]
  objects             LegalObject[]
  chatMessages        ChatMessage[]
  paymentTransactions PaymentTransaction[]
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, category])
}

model LegalObject {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  clientId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cases       LegalCase[]
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
}

model LegalCase {
  id              String              @id @default(cuid())
  workspaceId     String
  code            String
  title           String
  status          CaseStatus          @default(NEW)
  /// CONSULTATION — консультация; COURT — судебное; PROJECT — проект документов
  kind            CaseKind            @default(COURT)
  outcome         CaseOutcome?
  courtInstance   CourtInstance?
  /// Связь: консультация → судебное дело
  parentCaseId    String?
  parentCase      LegalCase?          @relation("CaseTree", fields: [parentCaseId], references: [id], onDelete: SetNull)
  childCases      LegalCase[]         @relation("CaseTree")
  assignedLawyer  String?
  expectedAmount  Float?
  paidAmount      Float?
  deadline        DateTime?
  clientId        String
  objectId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  description     String?
  documents       CaseDocument[]
  contracts       Contract[]
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  object          LegalObject?        @relation(fields: [objectId], references: [id])
  tasks           Task[]
  messages        ChatMessage[]
  payments        PaymentTransaction[]
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, kind])
  @@index([workspaceId, outcome])
  @@index([parentCaseId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  legalCaseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id              String    @id @default(cuid())
  name            String
  path            String
  legalCaseId     String
  /// decision | contract | evidence | correspondence | other
  category        String    @default("other")
  storageProvider String    @default("crm")
  externalUrl     String?
  mimeType        String?
  sizeBytes       Int?
  extractedText   String?   @db.Text
  createdAt       DateTime  @default(now())
  legalCase       LegalCase @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)

  @@index([legalCaseId])
}

model Contract {
  id           String         @id @default(cuid())
  workspaceId  String
  number       String
  counterparty String
  bin_iin      String?
  startDate    DateTime       @default(now())
  endDate      DateTime?
  type         String
  status       ContractStatus @default(DRAFT)
  clientId     String?
  legalCaseId  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  legalCase    LegalCase?     @relation(fields: [legalCaseId], references: [id], onDelete: SetNull)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId])
}

model ChatMessage {
  id          String     @id @default(cuid())
  workspaceId String
  role        String
  content     String     @db.Text
  legalCaseId String?
  /// Сообщения из ЛК клиента (подсчёт лимитов AI, история).
  clientId    String?
  contextType String     @default("case")
  createdAt   DateTime   @default(now())
  legalCase   LegalCase? @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contextType])
  @@index([legalCaseId])
  @@index([clientId, contextType, createdAt])
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  COURT
  ON_HOLD
  CLOSED
}

enum ClientCategory {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum CaseKind {
  CONSULTATION
  COURT
  PROJECT
}

enum CaseOutcome {
  PENDING
  WON_FULL
  WON_PARTIAL
  DISMISSED
  REJECTED
  LEFT_WITHOUT_CONSIDERATION
  TERMINATED
  SETTLED
  IN_APPEAL
  IN_CASSATION
  IN_SUPREME
}

enum CourtInstance {
  FIRST
  APPEAL
  CASSATION
  SUPREME
}

enum ContractStatus {
  DRAFT
  NEGOTIATION
  SIGNED
  EXPIRING
  ARCHIVED
}

/// Сессия чата Джарвис (история как в ChatGPT).
model JarvisSession {
  id          String          @id @default(cuid())
  workspaceId String
  title       String          @default("Новый чат")
  pinned      Boolean         @default(false)
  project     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    JarvisMessage[]
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, pinned])
}

model JarvisMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String
  content   String        @db.Text
  metadata  Json?
  createdAt DateTime      @default(now())
  session   JarvisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// Платежи: Rekassa, 1С, ручной ввод
model PaymentTransaction {
  id          String     @id @default(cuid())
  workspaceId String
  legalCaseId String?
  clientId    String?
  amount      Float
  currency    String     @default("KZT")
  source      String
  externalId  String?
  paidAt      DateTime   @default(now())
  description String?
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalCase   LegalCase? @relation(fields: [legalCaseId], references: [id], onDelete: SetNull)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, paidAt])
  @@index([legalCaseId])
  @@index([clientId])
}
